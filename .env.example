# ===================================================
# FIREBASE CONFIGURATION
# ===================================================
# ใน Config เหนือนี้: Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ===================================================
# SERVER-SIDE VARIABLES (Vercel Serverless Functions in /api)
# ===================================================
# ห้ามขึ้นต้นด้วย VITE_ — ตัวแปร VITE_* ถูกฝังลงใน JS ที่ส่งให้ทุกคน
# ตั้งใน Vercel: Project > Settings > Environment Variables
# (ใช้ทดสอบในเครื่องด้วย `vercel dev` + `vercel env pull .env.local`)

# --- Price providers (api/quote.js) — ชื่อเดียวกับ GitHub Actions secrets ---
# Finnhub: https://finnhub.io/  (free: 60 calls/min)
FINNHUB_API_KEY=your_finnhub_api_key_here
# Financial Modeling Prep: https://site.financialmodelingprep.com/developer/docs  (free: 250/day)
FMP0N8_API_KEY=your_fmp_api_key_here
# Twelve Data: https://twelvedata.com/  (free: 800 credits/day)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
# EODHD: https://eodhistoricaldata.com/  (free: 20 calls/day)
EODHD_API_KEY=your_eodhd_api_key_here
# Alpha Vantage (ใช้เฉพาะ scripts/update-all-assets.cjs ผ่าน GitHub Actions)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# --- Flag sync (api/sync-flags.js) ---
# Fine-grained PAT: เลือกเฉพาะ repo นี้ + Repository permissions > Contents: Read and write
GITHUB_SYNC_TOKEN=github_pat_xxxx
# ไม่บังคับ — ถ้าไม่ตั้ง จะใช้ VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG และ branch main
# GITHUB_OWNER=navykao
# GITHUB_REPO=my-etf-portfolio
# GITHUB_BRANCH=main
# อีเมล Google ของเจ้าของ (คั่นด้วย ,) — มีสิทธิ์ sync flag เท่านั้น
ALLOWED_EMAILS=you@example.com

# --- ไม่บังคับ: ใช้ VITE_FIREBASE_API_KEY (ข้างบน) เป็นค่าเริ่มต้นสำหรับตรวจ ID token ---
# FIREBASE_API_KEY=your_firebase_api_key_here
